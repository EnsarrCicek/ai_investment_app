FIREBASE_PROJECT_ID=ai-investment-app-2026

# EventIntelligenceEngine için OpenAI API anahtarı — kendi anahtarınla değiştir.
OPENAI_API_KEY=

# İsteğe bağlı: varsayılan modelleri değiştirmek istersen (aksi halde bu
# varsayılanlar kullanılır)
# EVENT_INTELLIGENCE_PRIMARY_MODEL=gpt-5.6-luna
# EVENT_INTELLIGENCE_FALLBACK_MODEL=gpt-5.6-terra

# İsteğe bağlı: toplam OpenAI bütçeniz (USD) — /usage ekranındaki "kalan
# bakiye" bu değerden hesaplanır (aksi halde $5 varsayılır)
# EVENT_INTELLIGENCE_BUDGET_USD=5.0

# Günlük toplu analiz job'ını (POST /jobs/daily-analysis, Google Cloud
# Scheduler tarafından çağrılır) korumak için paylaşılan gizli anahtar —
# ayarlanmamışsa bu uç nokta devre dışı kalır (403 döner).
# DAILY_JOB_SECRET=
